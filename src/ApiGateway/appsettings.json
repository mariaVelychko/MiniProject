{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "*" ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "MiniProject",
    "Audience": "MiniProject.Clients"
  },
  "Gateway": {
    "Timeouts": {
      "ClientSeconds": 2,
      "ProxySeconds": 5,
      "HealthSeconds": 1
    },
    "Cache": {
      "CatalogTtlSeconds": 60
    },
    "RateLimits": {
      "WindowSeconds": 60,
      "AnonymousPerWindow": 100,
      "AuthenticatedBurst": 100,
      "AuthenticatedPerWindow": 120,
      "LoginPerWindow": 5
    }
  }
}
