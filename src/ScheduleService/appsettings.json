{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": { "FormatterOptions": { "IncludeScopes": true } }
  },
  "AllowedHosts": "*",
